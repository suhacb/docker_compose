# Path to the ENS3 solution root on your machine (directory containing ENS3.sln).
# All service Dockerfiles are built relative to this directory.
SOURCE_DIR=../../src/ens3

# PostgreSQL
POSTGRES_PASSWORD=postgres

# MinIO object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Gateway scope passed to app and admin (used by Azure AD path only)
AZURE_AD_SERVER_SCOPE=https://ENS3.onmicrosoft.com/server/access_as_user

# Keycloak OIDC client secret — required when AUTH_PROVIDER=keycloak
KEYCLOAK_CLIENT_SECRET=

# Keycloak admin credentials — used by the demo data seeder to resolve user IDs
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# Telerik NuGet credentials — required only to build ENS3.Hosts.UI.
# Temporary until issue #5 (Remove ENS3.UI) is merged.
TELERIK_USERNAME=
TELERIK_PASSWORD=
