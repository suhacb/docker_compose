# Za vsako okolje posebej določi naslednje vrednosti.
# Porti sledijo bazi 10100 (10 tisoč za princess projekt):
#   - 10100 je frontend
#   - 10105 je backend app
#   - 10106 je pgAdmin
#   - 10107 je Zinc Search
#   - 10108 je Qdrant
#   - 10109 je Redis
# POMEMBNO: ko določite parameter NETWORK, morate obvezno to isto ime omrežja
# vnesti v docker-compose.yml

APP_NAME=princess_backend
APP_PORT=10105
NETWORK=princess

PGADMIN_PORT=10106
PGADMIN_DEFAULT_EMAIL=<INSERT PGADMIN LOGIN EMAIL, ex. admin@example.com>
PGADMIN_DEFAULT_PASSWORD=<INSERT PGADMIN LOGIN PASSWORD>

POSTGRES_DB=princess
POSTGRES_USER=princess
POSTGRES_PASSWORD=<INSERT PASSWORD FOR POSTGRES_USER>
POSTGRES_TEST_DB=princess_test

ZINC_DATA_PATH=/data
ZINC_FIRST_ADMIN_USER=<INSERT ZINC ADMIN USERNAME, ex. admin>
ZINC_FIRST_ADMIN_PASSWORD=<INSERT ZINC ADMIN PASSWORD>
ZINC_PORT=10107

QDRANT_HTTP_PORT=10108

REDIS_PORT=10109

# Ollama runs bare metal on the host — do not add to Docker Compose.
# On Docker Desktop (Mac/Windows) this resolves automatically.
# On Linux, add extra_hosts: ["host.docker.internal:host-gateway"] to the php and artisan services.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_PORT=11434

E2E_TOKEN=<INSERT RANDOM SECRET, ex. output of: openssl rand -hex 32>

APP_DIR=/var/www/html
SERVICE_TAGS=dev
SERVICE_NAME=db
CODE_DIR=<INSERT FULL PATH TO LOCAL SOURCE CODE, ex. /Users/username/Documents/projects/src/princess_backend>
